# ==============================================================================
# Northstar Renovation - Production Security Hardening Directives (.htaccess)
# ==============================================================================

# 1. Disable Directory Indexing / Browsing
Options -Indexes

# 2. Block Access to Hidden and Sensitive System Files (.git, .env, etc.)
<FilesMatch "^\.(.*)|.*\.env|.*\.log|.*\.sql|.*\.bak|.*\.swp|composer\.(json|lock)|package(-lock)?\.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Protect wp-config.php
<Files "wp-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 4. Protect XML-RPC against brute force amplification
<Files "xmlrpc.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 5. HTTP Security Headers (Defense-in-Depth)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header set X-Robots-Tag "noai, noimageai"
</IfModule>
